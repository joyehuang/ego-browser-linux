# Core X11 / locale / Chrome runtime
DISPLAY=:99
TZ=America/Los_Angeles
LANG=en_US.UTF-8
EGO_LINUX_CDP_URL=http://127.0.0.1:19222
EGO_LINUX_PROFILE=/home/{{USER}}/.local/share/ego-browser/profile
EGO_BROWSER_STATE_DIR=/home/{{USER}}/.ego-browser/state
EGO_BROWSER_AGENT_WORKSPACE={{REPO_DIR}}/package/ego-browser/dist/out/agent-skills/ego-browser

# Optional: route Chrome egress through a residential / dual-ISP SOCKS5 or HTTP proxy
# to avoid datacenter IP blocks and CAPTCHAs (e.g. local SSH tunnel or proxy daemon).
# EGO_LINUX_PROXY=socks5://127.0.0.1:10809

# Unified Web Console (TaskSpaces + embedded noVNC)
# Mode 1 (default, SSH tunnel): bind 127.0.0.1 and forward locally via `ssh -N -L 6080:127.0.0.1:6080 <vps-host>`
# Mode 2 (Tailscale / ZeroTier direct): set EGO_CONSOLE_HOST=<tailscale-ip> and EGO_CONSOLE_PUBLIC_URL=http://<tailscale-ip>:6080
# Mode 3 (Public domain + Caddy/Nginx/Cloudflare Tunnel): keep EGO_CONSOLE_HOST=127.0.0.1, set EGO_CONSOLE_PUBLIC_URL and EGO_CONSOLE_TOKEN
EGO_CONSOLE_HOST=127.0.0.1
EGO_CONSOLE_PORT=6080
EGO_NOVNC_PORT=6081
EGO_VNC_UPSTREAM=127.0.0.1:6081
EGO_SSH_HOST={{VPS_SSH_HOST}}
# EGO_CONSOLE_PUBLIC_URL=https://browser.example.com
# EGO_CONSOLE_TOKEN=replace-with-random-token
# EGO_CONSOLE_INCLUDE_TOKEN_IN_URL=0

# Plugin & E2E Workflow discovery (default: ~/.config/ego-browser/plugins)
# EGO_BROWSER_PLUGINS_DIR=/home/{{USER}}/.config/ego-browser/plugins
# EGO_BROWSER_PLUGINS=/path/to/repo/e2e/app.ego-plugin.mjs
